# Modèle d'unité systemd : deploy/install.sh remplace @USER@, @DIR@ et @PORT@.
[Unit]
Description=Tournoi de flechettes (ecran + saisie)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=TOURNOI_PORT=@PORT@
ExecStart=/usr/bin/python3 @DIR@/server.py
Restart=always
RestartSec=2
# Priorité basse : les autres services de la machine passent toujours avant
Nice=15
CPUQuota=25%
MemoryMax=100M
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
